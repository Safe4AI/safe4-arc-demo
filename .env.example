# Safe4 local development example.
# Copy to .env for local use. Do not commit real values.

PAYMENT_FIREWALL_ENV=development
PORT=8090
APP_PORT=8090

# Use PostgreSQL for realistic local testing, or leave unset and use SQLite.
PAYMENT_FIREWALL_POSTGRES_DSN=postgresql://firewall_user:firewall_password@localhost:5432/agentic_payments_firewall
PAYMENT_FIREWALL_DB_PATH=payment_firewall.db

# Required for receipt issuance and receipt verification.
PAYMENT_FIREWALL_ADMIN_SECRET=replace-with-local-admin-secret
PAYMENT_FIREWALL_RECEIPT_SECRET=replace-with-local-receipt-secret

# Public-facing metadata and payment routing. Required in production; use an
# explicit recipient for the selected network. Never use "wallet_address".
PAYMENT_FIREWALL_PAY_TO=
PAYMENT_FIREWALL_OAUTH_ISSUER=http://localhost:8090
PAYMENT_FIREWALL_X402_SUPPORTED_NETWORKS=arc-testnet,base,solana,ethereum-l2
PAYMENT_FIREWALL_X402_NETWORK_RECIPIENTS=
PAYMENT_FIREWALL_PHASE3_X402_ADVANCED_ENABLED=true

# Demo-only protected pages. Leave unset to disable them locally.
PAYMENT_FIREWALL_DEMO_ACCESS_TOKEN=

# Core runtime defaults.
PAYMENT_FIREWALL_FEE_RATE=0.0025
PAYMENT_FIREWALL_RECEIPT_TTL_SECONDS=300
PAYMENT_FIREWALL_RATE_LIMIT_REQUESTS=60
PAYMENT_FIREWALL_RATE_LIMIT_WINDOW_SECONDS=60
MIN_DESCRIPTION_WORDS=10
